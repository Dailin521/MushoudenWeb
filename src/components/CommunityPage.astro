---
import Layout from '../layouts/Layout.astro';
import { copy, site, type Locale } from '../lib/site';
import { icons } from '../data/social-icons.json';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const channels = [
  { icon: 'discord' as const, name: 'Discord', account: 'Three Kingdoms Mushouden', href: site.discord },
  { icon: 'bilibili' as const, name: locale === 'zh' ? '哔哩哔哩' : 'Bilibili', account: '猛将三国', href: site.bilibili },
  { icon: 'x' as const, name: 'X', account: '@Mushouden3', href: site.x },
  { icon: 'douyin' as const, name: locale === 'zh' ? '抖音' : 'Douyin', account: '猛将三国', href: site.douyin },
  { icon: 'xiaohongshu' as const, name: locale === 'zh' ? '小红书' : 'Xiaohongshu', account: '猛将三国', href: site.xiaohongshu },
];
---
<Layout locale={locale} title={t.nav[3]} section="community" pathname="community">
  <div class="container community-container">
    <header class="community-heading"><h1>{t.communityTitle}</h1><p>{t.communityIntro}</p></header>
    <div class="community-directory">
      <section class="qq-section" aria-labelledby="qq-heading">
        <h2 id="qq-heading" class="directory-title">
          <svg viewBox={icons.qq.viewBox} width="26" height="26" fill="currentColor" aria-hidden="true"><path d={icons.qq.path} /></svg>
          {t.qq}
        </h2>
        <div class="group-list">{site.groups.map((number, index) => <article class="group">
          <div class="group-info">
            <h3>{site.qqGroupLinks[number]
              ? <a class="group-join" href={site.qqGroupLinks[number]} target="_blank" rel="noopener noreferrer" aria-label={`${t.joinGroup} · ${t.groupNames[index]}`}>{t.groupNames[index]}<span aria-hidden="true">↗</span></a>
              : t.groupNames[index]}</h3>
            <p class="copy-value">{number}</p>
          </div>
          <button class="copy-button" data-copy={number} data-success={t.copied} data-failure={t.copyFailed} aria-label={`${t.copyNumber} ${number}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg>
          </button>
          <p class="copy-status" role="status"></p>
        </article>)}</div>
      </section>
      <section id="social" class="social-section" aria-labelledby="social-heading">
        <h2 id="social-heading" class="directory-title">{t.social}</h2>
        <div class="social-list">{channels.map(channel => (
          <a class="social-row" href={channel.href} target="_blank" rel="noopener noreferrer">
            <span class="channel-mark" aria-hidden="true"><svg class:list={{ 'channel-mark-wide': channel.icon === 'xiaohongshu' }} viewBox={icons[channel.icon].viewBox} fill="currentColor"><path d={icons[channel.icon].path} /></svg></span>
            <span class="channel-info"><span class="social-platform">{channel.name}</span><span class="channel-account">{channel.account}</span></span>
            <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
        ))}</div>
      </section>
    </div>
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
      let feedbackTimer: ReturnType<typeof setTimeout>;
      button.addEventListener('click', async () => {
        const status = button.closest('.group')?.querySelector<HTMLElement>('.copy-status');
        const value = button.dataset.copy || '';
        if (!status) return;
        clearTimeout(feedbackTimer);
        try {
          if (!navigator.clipboard) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(value);
          status.textContent = button.dataset.success || '';
        } catch {
          status.textContent = button.dataset.failure || '';
          const visibleValue = button.closest('.group')?.querySelector('.copy-value');
          if (visibleValue) { const range = document.createRange(); range.selectNodeContents(visibleValue); const selection = window.getSelection(); selection?.removeAllRanges(); selection?.addRange(range); }
        }
        feedbackTimer = setTimeout(() => { status.textContent = ''; }, 2500);
      });
    });
  </script>
</Layout>
