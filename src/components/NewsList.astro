---
import Layout from '../layouts/Layout.astro';
import { asset, copy, dateLabel, url, type Locale } from '../lib/site';
import { news, newsContent, pageSize, totalPages } from '../lib/news';
interface Props { locale: Locale; page?: number }
const { locale, page = 1 } = Astro.props;
const t = copy[locale];
const entries = news.slice((page - 1) * pageSize, page * pageSize);
const pagePath = (n: number) => n === 1 ? '' : `news/page/${n}`;
---
<Layout locale={locale} section="news" pathname={pagePath(page)}>
  <div class="container news-container">
    <div class="page-kicker"><h1>{t.news}</h1><span>{t.newsEn}</span></div>
    <div class="news-list">
      {entries.map((entry, index) => {
        const { content, isFallback, actualLocale } = newsContent(entry, locale);
        return <article class:list={['news-row', { reverse: index % 2 === 1 }]}>
          <a class:list={['news-cover', { 'patch-cover': content.cover === '/media/news/fix.svg' }]} href={url(locale, `news/${entry.id}`)} tabindex="-1" aria-hidden="true">
            <img src={asset(content.cover || '/media/game/strategy.webp')} alt="" width="800" height="540" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
          </a>
          <div class="news-text" lang={actualLocale === 'zh' ? 'zh-CN' : 'en'}>
            <time datetime={entry.publishedAt}>{dateLabel(entry.publishedAt, locale)}</time>
            <h2><a href={url(locale, `news/${entry.id}`)}>{content.title}</a></h2>
            {isFallback && <p class="language-note">{t.fallback}</p>}
            <p class="news-summary">{content.summary}</p>
            <a class="text-link" href={url(locale, `news/${entry.id}`)}>{t.read}<span aria-hidden="true">↗</span><span class="sr-only"> — {content.title}</span></a>
          </div>
        </article>;
      })}
    </div>
    <nav class="pagination" aria-label={locale === 'zh' ? '动态分页' : 'News pagination'}>
      <div>{page > 1 && <a href={url(locale, pagePath(page - 1))}>← {t.previous}</a>}</div>
      <span>{String(page).padStart(2, '0')} <span class="muted">/ {String(totalPages).padStart(2, '0')}</span></span>
      <div>{page < totalPages && <a href={url(locale, pagePath(page + 1))}>{t.next} →</a>}</div>
    </nav>
  </div>
</Layout>
