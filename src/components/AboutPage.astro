---
import Layout from '../layouts/Layout.astro';
import { asset, copy, site, url, type Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---
<Layout locale={locale} title={t.nav[2]} section="about" pathname="about">
  <div class="container about-container">
    <header class="about-header">
      <div>
        <span class="eyebrow">{t.aboutSub}</span>
        <h1>{site.name}</h1>
        <p class="about-intro">{t.aboutIntro}</p>
      </div>
      <div class="about-operator">
        <p>{t.operatedBy}</p>
        <a class="text-link" href={url(locale, 'contact')}>{t.contactTitle}<span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <section class="about-work" aria-labelledby="about-game-title">
      <figure class="about-image">
        <img src={asset('/media/game/strategy.webp')} alt={locale === 'zh' ? '猛将三国：两位谋士围绕沙盘筹划' : 'Two strategists studying a campaign map in Mushouden'} width="1600" height="900" fetchpriority="high" />
        <figcaption>{locale === 'zh' ? '《猛将三国》游戏美术' : 'Artwork from Three Kingdoms: Mushouden'}</figcaption>
      </figure>
      <div class="about-work-copy">
        <span class="eyebrow">{t.aboutWork}</span>
        <h2 id="about-game-title">{t.game}</h2>
        <p>{t.aboutBody}</p>
        <p class="about-release">{t.aboutReleased}</p>
        <a class="text-link" href={url(locale, 'games')}>{t.footerGame}<span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Layout>
