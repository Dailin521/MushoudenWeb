---
import '../styles/global.css';
import { imagePath, navigation, sitePath, studio, type PagePath } from '../lib/site';

interface Props {
  title: string;
  page?: PagePath;
  description?: string;
}

const { title, page, description = studio.description } = Astro.props;
const canonical = page && Astro.site ? new URL(sitePath(page), Astro.site).href : undefined;
const shareImage = imagePath(page === '/' ? 'gods-on-duty' : 'studio-logo');
const emailLink = `mailto:${studio.email}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4a355e" />
    <title>{title} | {studio.name}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {!page && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} | ${studio.name}`} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(shareImage, Astro.site).href} />}
    <link rel="icon" type="image/webp" href={imagePath('studio-logo')} />
    <link rel="preload" href={sitePath('/fonts/noto-sans-sc-latin.woff2')} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand header-brand" href={sitePath('/')} translate="no">{studio.name}</a>
        <nav class="navigation" aria-label="Main navigation">
          <ul class="nav-pages">
            {navigation.map(({ label, path }) => (
              <li><a href={sitePath(path)} aria-current={page === path ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
          <span class="site-language">
            <span aria-hidden="true">EN</span>
            <span class="visually-hidden">Site language: English</span>
          </span>
          <a class="header-email" href={emailLink} aria-label={`Email ${studio.name}`}>
            <span class="envelope" aria-hidden="true"></span>
          </a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="footer-studio">
          <a class="brand footer-brand" href={sitePath('/')} translate="no">{studio.name}</a>
          <p>{studio.description}</p>
        </div>
        <div class="footer-contact">
          <a class="footer-contact-page" href={sitePath('/contact/')}>Contact Us <span class="envelope" aria-hidden="true"></span></a>
          <p><a href={emailLink}>{studio.email}</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
