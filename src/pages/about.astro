---
import Layout from '../layouts/Layout.astro';
import { imagePath, studio } from '../lib/site';
---
<Layout title="About" page="/about/">
  <div class="shell short-page about-page">
    <h1 class="visually-hidden">About {studio.name}</h1>
    <img src={imagePath('studio-logo')} width="413" height="98" alt="Platypus Games Team logo" />
    <p>{studio.description}</p>
  </div>
</Layout>
